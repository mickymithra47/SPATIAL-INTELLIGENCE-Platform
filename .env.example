# Environment Configuration Template

# Database & Storage
DATABASE_URL="postgresql://spatial_admin:spatial_secret@localhost:5432/spatial_campus_db?schema=public"
POSTGRES_USER="spatial_admin"
POSTGRES_PASSWORD="spatial_secret"
POSTGRES_DB="spatial_campus_db"
REDIS_URL="redis://localhost:6379"

# AI Provider Configuration
LLM_PROVIDER="openai" # openai | anthropic | gemini
OPENAI_API_KEY="sk-..."
EMBEDDING_MODEL="text-embedding-3-small"
LLM_MODEL="gpt-4o"

# Auth & Security
JWT_SECRET="super-secret-jwt-signing-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# App Ports
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_MAPBOX_TOKEN=""
