datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// TENANCY & ORGANIZATIONS
// ---------------------------------------------------------

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  planTier    String   @default("PILOT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campuses    Campus[]
  users       User[]
  departments Department[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Campus {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String
  latitude       Float
  longitude      Float
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildings      Building[]

  @@unique([organizationId, code])
  @@map("campuses")
}

// ---------------------------------------------------------
// SPATIAL HIERARCHY
// ---------------------------------------------------------

model Building {
  id          String   @id @default(uuid()) @db.Uuid
  campusId    String   @db.Uuid
  name        String
  code        String
  totalFloors Int      @default(1)
  createdAt   DateTime @default(now())

  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  floors      Floor[]

  @@unique([campusId, code])
  @@map("buildings")
}

model Floor {
  id               String     @id @default(uuid()) @db.Uuid
  buildingId       String     @db.Uuid
  floorNumber      Int
  name             String
  elevationMeters  Float      @default(0.0)
  floorPlanSvgUrl  String?
  createdAt        DateTime   @default(now())

  building         Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms            Room[]
  waypoints        Waypoint[]

  @@unique([buildingId, floorNumber])
  @@map("floors")
}

model Room {
  id           String    @id @default(uuid()) @db.Uuid
  floorId      String    @db.Uuid
  departmentId String?   @db.Uuid
  roomNumber   String
  name         String
  roomType     String    // CLASSROOM, LAB, OFFICE, AUDITORIUM, etc.
  capacity     Int       @default(30)
  isAccessible Boolean   @default(true)
  createdAt    DateTime  @default(now())

  floor        Floor       @relation(fields: [floorId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  equipment    Equipment[]
  bookings     Booking[]
  classes      ClassSession[]
  tickets      MaintenanceTicket[]

  @@unique([floorId, roomNumber])
  @@map("rooms")
}

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms          Room[]
  users          User[]

  @@map("departments")
}

// ---------------------------------------------------------
// WAYFINDING & NAVIGATION GRAPH
// ---------------------------------------------------------

model Waypoint {
  id           String      @id @default(uuid()) @db.Uuid
  floorId      String      @db.Uuid
  latitude     Float
  longitude    Float
  waypointType String      // DOOR, JUNCTION, ELEVATOR, STAIR, EMERGENCY_EXIT
  isAccessible Boolean     @default(true)

  floor        Floor       @relation(fields: [floorId], references: [id], onDelete: Cascade)
  outgoingEdges RouteEdge[] @relation("SourceWaypoint")
  incomingEdges RouteEdge[] @relation("TargetWaypoint")

  @@map("waypoints")
}

model RouteEdge {
  id               String   @id @default(uuid()) @db.Uuid
  sourceWaypointId String   @db.Uuid
  targetWaypointId String   @db.Uuid
  distanceMeters   Float
  isAccessible     Boolean  @default(true)
  isStair          Boolean  @default(false)
  isElevator       Boolean  @default(false)

  sourceWaypoint   Waypoint @relation("SourceWaypoint", fields: [sourceWaypointId], references: [id], onDelete: Cascade)
  targetWaypoint   Waypoint @relation("TargetWaypoint", fields: [targetWaypointId], references: [id], onDelete: Cascade)

  @@map("route_edges")
}

// ---------------------------------------------------------
// ASSETS & EQUIPMENT
// ---------------------------------------------------------

model Equipment {
  id               String              @id @default(uuid()) @db.Uuid
  roomId           String              @db.Uuid
  assetTag         String              @unique
  name             String
  category         String              // COMPUTER, PROJECTOR, SMART_BOARD, etc.
  status           String              @default("OPERATIONAL") // OPERATIONAL, DEGRADED, MAINTENANCE
  modelNumber      String?
  serialNumber     String?
  specifications   Json?               @default("{}")
  lastServicedAt   DateTime?
  warrantyExpiry   DateTime?
  createdAt        DateTime            @default(now())

  room             Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tickets          MaintenanceTicket[]

  @@map("equipment")
}

// ---------------------------------------------------------
// OPERATIONS & MAINTENANCE
// ---------------------------------------------------------

model MaintenanceTicket {
  id               String    @id @default(uuid()) @db.Uuid
  ticketNumber     String    @unique
  roomId           String    @db.Uuid
  assetId          String?   @db.Uuid
  reportedByUserId String    @db.Uuid
  assignedToUserId String?   @db.Uuid
  issueSummary     String
  details          String?
  status           String    @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  priority         String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resolvedAt       DateTime?

  room             Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  asset            Equipment? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  reportedByUser   User      @relation("ReportedTickets", fields: [reportedByUserId], references: [id])
  assignedToUser   User?     @relation("AssignedTickets", fields: [assignedToUserId], references: [id])

  @@map("maintenance_tickets")
}

model ClassSession {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @db.Uuid
  classCode   String
  className   String
  facultyName String
  dayOfWeek   Int      // 1-7
  startTime   String   // "09:00"
  endTime     String   // "10:30"

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("class_sessions")
}

model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  userId    String   @db.Uuid
  startTime DateTime
  endTime   DateTime
  purpose   String
  status    String   @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED
  createdAt DateTime @default(now())

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

// ---------------------------------------------------------
// USERS, RBAC & AUDITING
// ---------------------------------------------------------

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  departmentId   String?      @db.Uuid
  email          String       @unique
  fullName       String
  passwordHash   String
  role           String       @default("STUDENT") // STUDENT, FACULTY, MAINTENANCE, CAMPUS_ADMIN, SUPER_ADMIN
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportedTickets MaintenanceTicket[] @relation("ReportedTickets")
  assignedTickets MaintenanceTicket[] @relation("AssignedTickets")
  bookings       Booking[]
  auditLogs      AuditLog[]

  @@map("users")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  actionType     String
  entityType     String
  entityId       String
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
